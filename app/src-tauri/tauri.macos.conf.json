{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": { "width": 620, "height": 420 },
        "appPosition": { "x": 170, "y": 200 },
        "applicationFolderPosition": { "x": 450, "y": 200 }
      }
    }
  }
}
