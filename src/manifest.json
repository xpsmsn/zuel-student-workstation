{
  "version": 2,
  "layers": {
    "L0 kernel": {
      "rank": 0,
      "desc": "内核：注册表 / 事件 / 页面表 / 生命周期 / 纯工具。不依赖任何人"
    },
    "L1 core": {
      "rank": 1,
      "desc": "状态、持久化、主题、通用零件、预置内容"
    },
    "L2 domain": {
      "rank": 2,
      "desc": "纯业务规则：零 DOM，**可在 node 里直接单测**"
    },
    "L3 shell": {
      "rank": 3,
      "desc": "外壳：路由、页面注册表、侧栏。**可以**调用页面（须显式声明在 routeDeps）"
    },
    "L5 feature": {
      "rank": 5,
      "desc": "页面与功能"
    }
  },
